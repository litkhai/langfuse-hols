{
  "realm": "langfuse",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "langfuse",
      "name": "Langfuse",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LANGFUSE_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "corp-saml",
      "displayName": "Corp (SAML)",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "entityId": "http://keycloak:8088/realms/langfuse",
        "singleSignOnServiceUrl": "http://keycloak:8088/realms/corp/protocol/saml",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        "principalType": "SUBJECT",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "false",
        "wantAuthnRequestsSigned": "false",
        "validateSignature": "false",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email",
      "identityProviderAlias": "corp-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "email",
        "user.attribute": "email",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "corp-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "firstName",
        "user.attribute": "firstName",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "corp-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "lastName",
        "user.attribute": "lastName",
        "syncMode": "INHERIT"
      }
    }
  ]
}
