<!-- Test 04: one ClickHouse user per Langfuse instance, each granted only its own database, plus lf_probe to
     show what system-table grants would reveal. Copied into users.d/ by 04-db-separation.sh and removed after.
     The stack's `clickhouse` user has no access management (Docker image default), so these users live in a
     config file instead of CREATE USER. Local test passwords, not secrets. -->
<clickhouse>
  <users>
    <lf_a>
      <password>dbsep-test-a</password>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants><query>GRANT ALL ON lf_a.*</query></grants>
    </lf_a>
    <lf_b>
      <password>dbsep-test-b</password>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants><query>GRANT ALL ON lf_b.*</query></grants>
    </lf_b>
    <lf_probe>
      <password>dbsep-test-probe</password>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT ALL ON lf_a.*</query>
        <query>GRANT SELECT ON system.parts</query>
        <query>GRANT SELECT ON system.mutations</query>
        <query>GRANT SELECT ON system.query_log</query>
      </grants>
    </lf_probe>
  </users>
</clickhouse>
